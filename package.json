{
  "name": "gloaming",
  "version": "0.5.0",
  "private": true,
  "description": "Instant-replay game clip recorder for Linux. The app itself is Python; Node is only used to build the web UI.",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iiSHKAS/gloaming.git"
  },
  "bugs": {
    "url": "https://github.com/iiSHKAS/gloaming/issues"
  },
  "homepage": "https://github.com/iiSHKAS/gloaming#readme",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "accents": "node --import ./tools/mcu-resolve.mjs tools/derive-accents.mjs",
    "i18n:check": "node tools/check-locales.mjs",
    "i18n:new": "node tools/new-locale.mjs",
    "theme:light": "node tools/gen-light-theme.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.4.1",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
